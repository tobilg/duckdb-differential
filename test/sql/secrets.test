# name: test/sql/secrets.test
# description: TYPE differential secrets carry DATA_PATH and S3 options (no credentials) for ATTACH
# group: [differential]

require differential

statement ok
SET differential_repository = '{TEST_DIR}/differential_secrets'

# A named secret applies when ATTACH names it with SECRET
statement ok
CREATE SECRET pool (TYPE differential, DATA_PATH '{TEST_DIR}/differential_secrets_pool')

statement ok
ATTACH 'differential:named' AS named (SECRET pool)

query I
SELECT data_path LIKE '%differential_secrets_pool' FROM differential_databases() WHERE database_name = 'named'
----
true

# Without SECRET, only the unnamed default secret applies
statement ok
ATTACH 'differential:plain' AS plain

query I
SELECT data_path IS NULL FROM differential_databases() WHERE database_name = 'plain'
----
true

statement ok
CREATE SECRET (TYPE differential, DATA_PATH '{TEST_DIR}/differential_secrets_default')

statement ok
ATTACH 'differential:defaulted' AS defaulted

query I
SELECT data_path LIKE '%differential_secrets_default' FROM differential_databases() WHERE database_name = 'defaulted'
----
true

# Secrets apply when a database is created: an existing database keeps its data path
statement ok
DETACH plain

statement ok
ATTACH 'differential:plain' AS plain

query I
SELECT data_path IS NULL FROM differential_databases() WHERE database_name = 'plain'
----
true

# An explicit DATA_PATH wins over the secret
statement ok
ATTACH 'differential:explicit' AS explicit (SECRET pool, DATA_PATH '{TEST_DIR}/differential_secrets_explicit')

query I
SELECT data_path LIKE '%differential_secrets_explicit' FROM differential_databases() WHERE database_name = 'explicit'
----
true

query II
SELECT name, type FROM duckdb_secrets() WHERE type = 'differential' ORDER BY name
----
__default_differential	differential
pool	differential

# Credentials are not accepted: they belong in TYPE s3 secrets or the AWS SDK chain
statement error
CREATE SECRET bad (TYPE differential, KEY_ID 'x')
----
Unknown parameter "key_id"

statement error
CREATE SECRET bad (TYPE differential, DATA_PATH '/x', SCOPE 's3://bucket/')
----
take no SCOPE

statement error
CREATE SECRET bad (TYPE differential, MAX_REQUESTS 99999999999)
----
outside supported range

statement error
ATTACH 'differential:other' AS other (SECRET missing)
----
Secret "missing" does not exist

query I
SELECT status LIKE 'matching TYPE s3 secret%' FROM differential_status() WHERE capability = 's3_credentials'
----
true
