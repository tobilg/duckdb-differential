# name: test/sql/maintenance.test
# description: collection, orphan cleanup, compaction, request replay and execution rules
# group: [differential]

require differential

statement ok
SET differential_repository = '{TEST_DIR}/differential_maintenance'

statement ok
ATTACH 'differential:m' AS m

statement ok
CREATE TABLE m.t AS SELECT range AS i FROM range(100000)

statement ok
CALL differential_create_snapshot('m', request_id => 'snap-1')

# Replaying a request returns the original result; changing its arguments fails
query I
SELECT snapshot_id FROM differential_create_snapshot('m', request_id => 'snap-1')
----
1

statement error
CALL differential_create_snapshot('m', name => 'other', request_id => 'snap-1')
----
Request ID reused with different payload

statement ok
UPDATE m.t SET i = i + 1

statement ok
CALL differential_create_snapshot('m')

statement ok
CALL differential_expire_snapshots('m', versions => [1])

query I
SELECT sum(deleted_objects) > 0 FROM differential_cleanup_old_files(cleanup_all => true)
----
true

query I
SELECT candidate_objects FROM differential_cleanup_old_files(dry_run => true)
----
0

query I
SELECT orphaned_files FROM differential_delete_orphaned_files(dry_run => true)
----
0

query I
SELECT roots_unchanged FROM differential_compact()
----
true

# Metadata pruning: old completed operations and history of expired snapshots
query II
SELECT table_name, rows FROM differential_cleanup_metadata(older_than => TIMESTAMPTZ '2000-01-01', dry_run => true) ORDER BY 1
----
history	0
operations	0

query I
SELECT rows > 0 FROM differential_cleanup_metadata(older_than => TIMESTAMPTZ '2999-01-01', dry_run => true) WHERE table_name = 'operations'
----
true

statement ok
CALL differential_cleanup_metadata(older_than => TIMESTAMPTZ '2999-01-01')

query I
SELECT count(*) FROM differential_operations() WHERE state = 'complete' AND kind <> 'snapshot_ancestry'
----
0

# Snapshot parent records (branch-merge ancestry) are never pruned
query I
SELECT count(*) > 0 FROM differential_operations() WHERE kind = 'snapshot_ancestry'
----
true

# A pruned request ID is a new request: it publishes a new snapshot
query I
SELECT snapshot_id FROM differential_create_snapshot('m', request_id => 'snap-1')
----
3

statement error
SELECT * FROM differential_cleanup_metadata(dry_run => true)
----
needs older_than

# Management functions run only in autocommit mode
statement ok
BEGIN

statement error
CALL differential_create_snapshot('m')
----
autocommit

statement ok
ROLLBACK

statement error
CALL differential_create_snapshot('m', no_such_parameter => 1)
----
no_such_parameter
