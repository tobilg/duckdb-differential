CREATE TABLE o.incompatible(id INT PRIMARY KEY,v INT)

statement ok
CALL differential_create_snapshot('o')

statement ok
CREATE TABLE t.incompatible(id INT PRIMARY KEY,v VARCHAR)

statement ok
CALL differential_create_snapshot('t')

query TITT
SELECT validation_state,conflicts,schema_conflict_details[1].kind,schema_conflict_details[1].object_name FROM differential_merge_snapshots_preview('d',1,5,6,schema_mode=>'additive') WHERE table_name='incompatible'
----
schema_conflicts	NULL	table_definition	incompatible

statement error
